# ==========================================================================
# AYSHO - Production environment (.env)
# Copy this file to /opt/aysho/.env on the VPS and fill in REAL values.
# NEVER commit this file to Git.
# ==========================================================================

# -- Domain & Docker registry -------------------------------------------
AYSHO_DOMAIN=aysho.tn
GHCR_OWNER=your-github-username
IMAGE_TAG=latest

# -- Public URL (required for Strapi admin panel behind nginx) -----------
# Must match exactly the domain where the site is served.
PUBLIC_URL=https://aysho.tn

# -- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=aysho
POSTGRES_USER=aysho
POSTGRES_PASSWORD=change-me-strong-password

# -- Strapi security keys -------------------------------------------------
# Generate with:
#   node -e "const c=require('crypto');console.log('APP_KEYS='+Array(4).fill(0).map(()=>c.randomBytes(32).toString('base64')).join(','));['API_TOKEN_SALT','ADMIN_JWT_SECRET','JWT_SECRET','TRANSFER_TOKEN_SALT','ENCRYPTION_KEY'].forEach(k=>console.log(k+'='+c.randomBytes(32).toString('base64')))"
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# -- Cloudinary (media) ----------------------------------------------------
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
CLOUDINARY_FOLDER=aysho

# -- Sentry (optional) -----------------------------------------------------
SENTRY_ENABLED=false
SENTRY_DSN=

# -- Resend email notifications --------------------------------------------
# Clé API : https://resend.com/api-keys
# RESEND_FROM : expéditeur, doit être un domaine/email vérifié dans Resend.
#   Sans domaine perso, seul on@resend.dev est autorisé (à vérifier dans le dashboard).
# RESEND_TO : destinataire (changez ici vers l'email de la propriété plus tard).
RESEND_API_KEY=
RESEND_FROM=on@resend.dev
RESEND_TO=

# -- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# -- Certbot --------------------------------------------------------------
# Email used for Let's Encrypt expiry notices
CERTBOT_EMAIL=admin@aysho.tn

# -- Backups ---------------------------------------------------------------
# Days of retention for PostgreSQL dumps
BACKUP_RETENTION_DAYS=14
# Optional external copy (OVH Object Storage / rclone remote). Leave empty for local-only.
BACKUP_RCLONE_REMOTE=