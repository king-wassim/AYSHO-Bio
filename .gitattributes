* text=auto

# Shell scripts and Docker/nginx files must stay LF (linux containers)
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.nginx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Makefile text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary