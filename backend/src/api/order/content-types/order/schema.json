{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "customerName": {
      "type": "string",
      "required": true
    },
    "customerPhone": {
      "type": "string",
      "required": true
    },
    "customerEmail": {
      "type": "email"
    },
    "customerAddress": {
      "type": "text",
      "required": true
    },
    "orderNumber": {
      "type": "string",
      "unique": true
    },
    "totalPrice": {
      "type": "decimal"
    },
    "state": {
      "type": "enumeration",
      "default": "pending",
      "enum": [
        "pending",
        "confirmed",
        "delivered",
        "cancelled"
      ]
    },
    "items": {
      "type": "json"
    }
  }
}
