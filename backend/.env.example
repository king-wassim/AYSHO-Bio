# ==========================================
# BACKEND ENVIRONMENT VARIABLES - EXAMPLE
# Copy to .env and fill in your values
# NEVER commit actual secrets to Git!
# ==========================================

# ==========================================
# SERVER CONFIGURATION
# ==========================================
HOST=0.0.0.0
PORT=1337
NODE_ENV=development

# ==========================================
# FRONTEND URL (for CORS)
# Production: https://aysho.tn
# Multiple origins: comma-separated list
# ==========================================
FRONTEND_URL=http://localhost:5173

# ==========================================
# DATABASE
# Development (SQLite):
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Production (PostgreSQL via Docker):
# DATABASE_CLIENT=postgres
# DATABASE_HOST=postgres
# DATABASE_PORT=5432
# DATABASE_NAME=aysho
# DATABASE_USERNAME=aysho
# DATABASE_PASSWORD=change-me-strong-password
# DATABASE_SSL=false
# Or use a connection string:
# DATABASE_URL=postgresql://aysho:change-me-strong-password@postgres:5432/aysho
# Pool size (keep small for a 4 GB VPS):
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# ==========================================
# SECURITY KEYS (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# ==========================================
# Generate 4 different keys for APP_KEYS (comma-separated)
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=generate-random-string
ADMIN_JWT_SECRET=generate-random-string
JWT_SECRET=generate-random-string
TRANSFER_TOKEN_SALT=generate-random-string
ENCRYPTION_KEY=generate-32-char-base64-string

# ==========================================
# CLOUDINARY (Media Storage)
# Get from: https://cloudinary.com/console
# ==========================================
# Production MUST use cloudinary:
UPLOAD_PROVIDER=local
CLOUDINARY_NAME=your-cloud-name
CLOUDINARY_KEY=your-api-key
CLOUDINARY_SECRET=your-api-secret
CLOUDINARY_FOLDER=aysho

# ==========================================
# SENTRY (Error Tracking) - Optional
# ==========================================
SENTRY_ENABLED=false
SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ENVIRONMENT=development

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=debug