# ==========================================
# BACKEND ENVIRONMENT VARIABLES - EXAMPLE
# Copy to .env and fill in your values
# NEVER commit actual secrets to Git!
# ==========================================

# ==========================================
# SERVER CONFIGURATION
# ==========================================
HOST=0.0.0.0
PORT=1337
NODE_ENV=development

# ==========================================
# FRONTEND URL (for CORS)
# ==========================================
FRONTEND_URL=http://localhost:5173

# ==========================================
# DATABASE (SQLite for development)
# ==========================================
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# For PostgreSQL (Production - Neon):
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
# DATABASE_SSL=true

# ==========================================
# SECURITY KEYS (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# ==========================================
# Generate 4 different keys for APP_KEYS (comma-separated)
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=generate-random-string
ADMIN_JWT_SECRET=generate-random-string
JWT_SECRET=generate-random-string
TRANSFER_TOKEN_SALT=generate-random-string
ENCRYPTION_KEY=generate-32-char-base64-string

# ==========================================
# CLOUDINARY (Media Storage)
# Get from: https://cloudinary.com/console
# ==========================================
CLOUDINARY_NAME=your-cloud-name
CLOUDINARY_KEY=your-api-key
CLOUDINARY_SECRET=your-api-secret

# ==========================================
# SENTRY (Error Tracking) - Optional
# Get from: https://sentry.io/settings/projects/
# ==========================================
SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ENVIRONMENT=development

# ==========================================
# EMAIL (Optional - Nodemailer)
# ==========================================
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USERNAME=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=AYSHO <noreply@aysho.tn>

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=debug