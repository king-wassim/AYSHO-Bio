# ==========================================
# FRONTEND ENVIRONMENT VARIABLES - EXAMPLE
# ==========================================

# Strapi Backend URL
# ------------------------------------------
# IMPORTANT - same-origin strategy:
# - Production (Nginx reverse proxy): LEAVE EMPTY ('').
#   The frontend then calls /api/... on the same domain (https://aysho.tn/api/...).
# - Local development: http://localhost:1337 (or rely on the Vite dev proxy).
#
# VITE_STRAPI_URL=
VITE_STRAPI_URL=http://localhost:1337

# Cloudinary (for image transformations on frontend)
# Only needed if the frontend must build Cloudinary URLs directly.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Sentry (Error Tracking) - Optional
VITE_SENTRY_DSN=https://xxx@sentry.io/xxx
VITE_SENTRY_ENVIRONMENT=development

# Analytics - Optional
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX