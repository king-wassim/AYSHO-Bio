# ==========================================
# AYSHO E-commerce - Root .gitignore
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
*.local

# Environment files
.env
.env.local
.env.*.local
.env.production
.env.staging
*.pem

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Testing
coverage/
.nyc_output/

# Misc
*.tsbuildinfo
.eslintcache
.stylelintcache

# Docker
.docker/

# Strapi specific
.tmp/
public/uploads/
.strapi/
.strapi-updater.json
.strapi-cloud.json
license.txt
exports/

# Database
*.db
*.sqlite
*.sqlite3

# Old cloud provider tooling
.neon
.neon/
.agents/skills/neon*
.agents/skills/neon-postgres/

# TypeScript
*.tsbuildinfo

# IDE
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Package manager
yarn.lock
pnpm-lock.yaml
npm-debug.log*
